@@ -1372,6 +1426,26 @@ if __name__ == "__main__":
     SEQ_SPAWN_XY = [-0.20, 0.45]
     if _SEQ_SPAWN:
         _seq_spawn_xy = list(SEQ_SPAWN_XY)
+        # Per-RUN spawn offset (--spawn-jitter). Drawn once here, not per trial:
+        # within a run the four objects already differ, so what the dataset lacks
+        # is variation BETWEEN runs. Seeded from --seed so a run is reproducible,
+        # and clamped to the counter's reachable envelope.
+        if args.spawn_jitter > 0.0:
+            _sj_rng = np.random.default_rng(args.seed)
+            _sj = _sj_rng.uniform(-args.spawn_jitter, args.spawn_jitter, 2)
+            # Clamp to the envelope real successful demos actually occupy:
+            # measured over 93 of them, x in [-0.351, -0.200], y in [0.350,
+            # 0.550], i.e. 0.61-0.76 m from base_link. (The layout comment's
+            # "0.30-0.42 m from the base" predates the robocasa counter and the
+            # sequential spawner -- it is stale for this configuration.)
+            _seq_spawn_xy = [
+                float(np.clip(SEQ_SPAWN_XY[0] + _sj[0], -0.36, -0.12)),
+                float(np.clip(SEQ_SPAWN_XY[1] + _sj[1], 0.34, 0.56)),
+            ]
+            print(f"[spawn-jitter] this run presents objects at "
+                  f"[{_seq_spawn_xy[0]:+.3f}, {_seq_spawn_xy[1]:+.3f}] "
+                  f"(nominal {SEQ_SPAWN_XY}, jitter +-{args.spawn_jitter:.3f} m, "
+                  f"seed={args.seed})")
 
