# Extracted datasets and training outputs — regenerate with scripts/
# Anchored with a leading slash: a bare `data/` also matches handil/data/, which
# silently kept the entire data-handling package (schema, extraction, action
# recovery, method resolution) out of version control.
/data/
/runs/
*.npz
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
uv.lock

# MuJoCo
MUJOCO_LOG.TXT
videos/
